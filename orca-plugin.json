{
  "manifestVersion": 1,
  "id": "matrixkoder",
  "publisher": "interstellar",
  "name": "MatrixKoder",
  "version": "0.1.1",
  "description": "Multi-agent orchestration dashboard and lane supervisor for Orca",
  "repository": "https://github.com/Interstellar-code/orca-matrixkoder",
  "engines": {
    "orca": ">=1.4.0"
  },
  "pluginApi": 1,
  "main": "out/worker.js",
  "contributes": {
    "panels": [
      {
        "id": "matrixkoder-panel",
        "title": "MatrixKoder",
        "icon": "layers",
        "entry": "web/index.html"
      }
    ],
    "commands": [
      {
        "id": "toggle-dashboard",
        "title": "MatrixKoder: Toggle Dashboard",
        "context": "global",
        "action": "sidebar.right.toggle"
      },
      {
        "id": "sweep-lanes",
        "title": "MatrixKoder: Sweep Lanes",
        "context": "worktree"
      }
    ],
    "keybindings": [
      {
        "command": "toggle-dashboard",
        "key": "Mod+Alt+M",
        "when": "global"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      },
      {
        "on": "worktree.created"
      },
      {
        "on": "worktree.removed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "terminal:send"
    },
    {
      "kind": "notifications:show"
    },
    {
      "kind": "events:subscribe"
    },
    {
      "kind": "storage"
    }
  ]
}
